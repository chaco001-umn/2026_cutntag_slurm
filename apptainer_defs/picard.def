Bootstrap: docker
From: condaforge/miniforge3:25.3.1-0

%labels
    Author Chacón
    Description "Apptainer image with Miniforge + java + picard 3.4.0"

%environment
    export PATH=/opt/bin:/opt/conda/envs/bio/bin:$PATH

%post
    set -eux

    # Update and create conda environment
    mamba create -y -n bio -c bioconda -c conda-forge \
        picard=3.4.0

    # Clean up conda cache
    conda clean -afy
    
